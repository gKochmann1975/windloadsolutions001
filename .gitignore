# Backups
.backups/
.archive/

# Videos (large files)
videos/

# Local development
.DS_Store
*.log
node_modules/
new_env/

# Environment variables — root and any subdir. Vault secrets to E:/secrets/.
.env
.env.*
!.env.example
!.env.sample

# Google OAuth credentials and related secret-bearing files —
# secrets MUST NOT live inside a code repo.
# Vault to E:/secrets/ instead. See feedback_secret_rotation_discipline.md.
# NOTE: Google/OAuth/client_secret_*.json is ALREADY in git history (commit
# 0d78aa9); this rule only prevents future re-adds. History rewrite +
# credential rotation are tracked separately under master directive 2026-05-10.
Google/

# Other secret-format files
.secrets/
*credential*
*client_secret*
*.pem
*.key

# Reference books / standards (large copyrighted PDFs — local reference only,
# never commit to the repo). Free/legit copies, but not ours to redistribute.
# NOTE: this ignores ALL *.pdf. To genuinely track a PDF, force it: git add -f file.pdf
Matrix Structural Analysis 2nd Edition/
*.pdf

# Local secret-bearing vendor folders — NEVER commit (live API keys, PE seal,
# DUNS, SMTP creds, customer PII). Keep these local-only / vault to E:/secrets/.
Stripe INFO/
Bob DeWitt PE Electronic Seal/
Duns & Bradstreet (D-U-N-S number)/
Gmail (SMTP)/
.Customers/

# Claude Code local config (may accumulate secrets in permissions allow-list)
.claude/settings.local.json
